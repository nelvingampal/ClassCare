{
  "name": "classcare",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start-local.cjs",
    "start:web": "node server.js",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-classcare",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-classcare \"node --test --test-concurrency=1 tests/firestore.rules.cjs tests/security.rules.cjs\"",
    "test:browser": "node tests/browser.cjs",
    "test:accessibility": "node tests/accessibility.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "fake-indexeddb": "6.2.2",
    "firebase": "11.10.0",
    "firebase-tools": "15.29.0",
    "playwright": "1.62.1"
  }
}
